# ============================================================
# Flutter SDK (embedded repo - huge source tree, don't track)
# ============================================================
flutter/
flutter/*
!.flutterignore

# ============================================================
# Flutter app build artifacts
# ============================================================
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/*.iml
flutter_app/.idea/
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/ephemeral/
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/android/.gradle/
flutter_app/android/local.properties
flutter_app/android/app/debug
flutter_app/android/app/profile
flutter_app/android/app/release

# ============================================================
# Python virtual env
# ============================================================
.venv/
__pycache__/
*.py[cod]

# ============================================================
# Node / backend
# ============================================================
backend/node_modules/
backend/package-lock.json

# Secrets - NEVER commit these
backend/.env
backend/env.txt
**/env.txt
*.env
!*.env.example
.env.local
.env.*.local

# ============================================================
# Logs & temp
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/